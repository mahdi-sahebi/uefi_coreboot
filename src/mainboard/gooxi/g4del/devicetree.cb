## SPDX-License-Identifier: GPL-2.0-or-later

chip soc/intel/xeon_sp/spr
	device domain 0 on
		device pci 1f.0 on
			chip superio/common
				device pnp 2e.0 on
					chip superio/aspeed/ast2400
						register "use_espi" = "1"
						device pnp 2e.2 on
							io 0x60 = 0x2f8
							irq 0x70 = 0x03
						end
						device pnp 2e.3 off end
					end
				end
			end
			chip drivers/ipmi
				device pnp ca2.0 on end
				register "bmc_i2c_address" = "0x20"
				register "bmc_boot_timeout" = "60"
			end
		end
	end
end
