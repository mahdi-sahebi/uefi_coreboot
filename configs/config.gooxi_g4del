CONFIG_OPTION_BACKEND_NONE=y
CONFIG_TIMESTAMPS_ON_CONSOLE=y
CONFIG_VENDOR_GOOXI=y
CONFIG_MAINBOARD_VERSION="port-0.1"
CONFIG_CONSOLE_POST=y
CONFIG_USE_LEGACY_8254_TIMER=y
CONFIG_IFD_BIN_PATH="deps/blobs/mainboard/gooxi/g4del/descriptor.bin"
CONFIG_ME_BIN_PATH="deps/blobs/mainboard/gooxi/g4del/me.bin"
CONFIG_GBE_BIN_PATH="deps/blobs/mainboard/gooxi/g4del/gbe.bin"
CONFIG_EDK2_BOOT_TIMEOUT=10
CONFIG_HAVE_IFD_BIN=y
CONFIG_HAVE_ME_BIN=y
CONFIG_HAVE_GBE_BIN=y
CONFIG_HAVE_DEVICE_EXP1_BIN=y
CONFIG_DEVICE_EXP1_BIN_PATH="deps/blobs/mainboard/gooxi/g4del/device_exp1.bin"
CONFIG_DO_NOT_TOUCH_DESCRIPTOR_REGION=y
# CONFIG_DASHARO_FIRMWARE_UPDATE_MODE is not set
CONFIG_RESOURCE_ALLOCATION_TOP_DOWN=y
CONFIG_DRIVERS_EFI_VARIABLE_STORE=y
CONFIG_DRIVERS_GENERIC_CBFS_SERIAL=y
CONFIG_DRIVERS_PS2_KEYBOARD=y
CONFIG_CONSOLE_SPI_FLASH=y
CONFIG_MAINBOARD_SERIAL_NUMBER="Unknown"
CONFIG_PAYLOAD_EDK2=y
CONFIG_GENERIC_LINEAR_FRAMEBUFFER=y
CONFIG_EDK2_REPO_CUSTOM=y
CONFIG_EDK2_REPOSITORY="https://github.com/mahdi-sahebi/uefi_edk2.git"
CONFIG_EDK2_TAG_OR_REV="ec2535b47c54d8af04c045cafccec58af2d130ea"
CONFIG_EDK2_USE_EDK2_PLATFORMS=y
CONFIG_EDK2_PLATFORMS_TAG_OR_REV="9ef9bcef5090effeb569f61c8585795fdb41d41d"
CONFIG_EDK2_DEBUG=y
CONFIG_EDK2_CBMEM_LOGGING=y
# CONFIG_EDK2_FULL_SCREEN_SETUP is not set
CONFIG_EDK2_DISABLE_TPM=y
CONFIG_EDK2_CUSTOM_BUILD_PARAMS="--pcd gEfiMdePkgTokenSpaceGuid.PcdDebugPrintErrorLevel=0x80000000 --pcd gEfiMdePkgTokenSpaceGuid.PcdFixedDebugPrintErrorLevel=0x80000000"
CONFIG_DASHARO=y
CONFIG_EDK2_DASHARO_SYSTEM_FEATURES=y
CONFIG_EDK2_DASHARO_SERIAL_REDIRECTION_DEFAULT_ENABLE=y
CONFIG_EDK2_HAVE_2ND_UART=y
CONFIG_EDK2_DUAL_SERIAL_DEBUG=y
CONFIG_EDK2_DASHARO_SERIAL_REDIRECTION2_DEFAULT_ENABLE=y
CONFIG_EDK2_PRINT_SOL_STRINGS=y
